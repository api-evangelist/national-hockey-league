    {
      "info": {
        "name": "Players",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Player landing details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-web.nhle.com/v1/player/:player/landing",
